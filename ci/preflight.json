{
  "sources": [
    "src"
  ],
  "test_roots": [
    "src/tests.zig",
    "src/property_test.zig"
  ],
  "test_support": [
    "src/testing/**"
  ],
  "test_dependencies": [
    "shakedown"
  ],
  "shipped": {
    "docs/design.md": "Published architecture and the contract of moving contexts between threads, linked from the README."
  },
  "function_exceptions": {},
  "layout_exceptions": {},
  "docs": {
    "zig build docs -- usage": {
      "source": "examples/usage.zig",
      "region": "usage",
      "imports": [
        "shuttle"
      ]
    },
    "zig build docs -- generator": {
      "source": "examples/usage.zig",
      "region": "generator",
      "imports": [
        "shuttle"
      ]
    },
    "zig build docs -- context": {
      "source": "examples/usage.zig",
      "region": "context",
      "imports": [
        "shuttle"
      ]
    },
    "zig build docs -- jobs": {
      "source": "examples/usage.zig",
      "region": "jobs",
      "imports": [
        "shuttle"
      ]
    }
  },
  "extra_checks": [
    [
      "zig",
      "build",
      "check-consumer"
    ]
  ],
  "glint": {
    "rules": [
      {"id": "P001", "level": "gate"},
      {"id": "P003", "level": "gate"},
      {"id": "A004", "level": "gate"},
      {"id": "Z026", "level": "gate"}
    ]
  }
}
